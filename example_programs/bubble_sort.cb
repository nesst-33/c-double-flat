void bubble_sort(arr int numbers) {
    int length = numbers!
    bool is_sorted = false
    
    while (is_sorted == false) {
        is_sorted = true 
        int i = 1
        
        while (i < length) {
            
            if (numbers[i - 1] > numbers[i]) {
                int temp = numbers[i]
                numbers[i] = numbers[i - 1]
                numbers[i - 1] = temp
                
                is_sorted = false
            }
            i += 1
        }
        
        length -= 1
    }
}

arr int dataset = [64, 34, 25, 12, 22, 11, 90]

{
    str scope_msg = "Starting sort for " ~ dataset! ~ " items..."
    print(scope_msg)
}

bubble_sort(dataset)

int max_idx = dataset! - 1
print("Smallest element: " ~ dataset[0])
print("Largest element: " ~ dataset[max_idx])
print(dataset)
