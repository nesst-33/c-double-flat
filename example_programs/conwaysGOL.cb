int count_neighbors(arr arr int grid, int r, int c, int rows, int cols) {
    int count = 0
    int i = r - 1
    
    while (i <= r + 1) {
        if (i >= 0 and i < rows) {
            int j = c - 1
            
            while (j <= c + 1) {
                if (j >= 0 and j < cols) {
                    
                    if (i != r or j != c) {
                        count += grid[i][j]
                    }
                }
                j += 1
            }
        }
        i += 1
    }
    
    return count
}

void print_generation(arr arr int grid, int rows, int cols, int gen_number) {
    clear()
    print("--- Generation " ~ gen_number ~ " ---")
    
    int i = 0
    while (i < rows) {
        str row_display = ""
        int j = 0
        
        while (j < cols) {
            if (grid[i][j] == 1) {
                row_display = row_display ~ "[O]"
            } else {
                row_display = row_display ~ " . "
            }
            j += 1
        }
        
        print(row_display)
        i += 1
    }
    print("") 
}

void simulate_life(arr arr int current_gen, arr arr int next_gen) {
    int rows = current_gen!
    int cols = current_gen[0]!
    
    int current_step = 0
    
    while (true) {
        
        print_generation(current_gen, rows, cols, current_step)
        
        int i = 0
        while (i < rows) {
            int j = 0
            while (j < cols) {
                int neighbors = count_neighbors(current_gen, i, j, rows, cols)
                
                if (current_gen[i][j] == 1) {
                    if (neighbors < 2 or neighbors > 3) {
                        next_gen[i][j] = 0
                    } else {
                        next_gen[i][j] = 1
                    }
                } else {
                    if (neighbors == 3) {
                        next_gen[i][j] = 1
                    } else {
                        next_gen[i][j] = 0
                    }
                }
                j += 1
            }
            i += 1
        }
        
        i = 0
        while (i < rows) {
            int j = 0
            while (j < cols) {
                current_gen[i][j] = next_gen[i][j]
                j += 1
            }
            i += 1
        }
        
        current_step += 1
    }
}

