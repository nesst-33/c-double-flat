# --- MATH LIBRARY ---

# Taylor Series Approximation for Sine
flp sin(flp raw_x) {
    flp x = raw_x
    # Wrap angle between -3.14159 and 3.14159
    while (x > 3.14159) {
        x -= 6.28318 
    }
    while (x < -3.14159) {
        x += 6.28318 
    }
    
    flp x2 = x * x
    flp x3 = x2 * x
    flp x5 = x3 * x2
    flp x7 = x5 * x2
    
    return x - (x3 / 6.0) + (x5 / 120.0) - (x7 / 5040.0)
}

# Taylor Series Approximation for Cosine
flp cos(flp raw_x) {
    flp x = raw_x
    while (x > 3.14159) { 
        x -= 6.28318 
    }
    while (x < -3.14159) { 
        x += 6.28318 
    }
    
    flp x2 = x * x
    flp x4 = x2 * x2
    flp x6 = x4 * x2
    
    return 1.0 - (x2 / 2.0) + (x4 / 24.0) - (x6 / 720.0)
}


