# --- RENDERING ENGINE ---

void render_frame(flp A, flp B) {
    # 1. Wipe the Buffers clean!
    int y = 0
    while (y < 22) {
        int x = 0
        while (x < 40) {
            z_buffer[y][x] = 0.0
            screen_buffer[y][x] = 0
            x += 1
        }
        y += 1
    }
    
    # 2. Pre-calculate rotation constants
    flp cosA = cos(A)
    flp sinA = sin(A)
    flp cosB = cos(B)
    flp sinB = sin(B)
    
    # 3. Theta Loop (j)
    flp j = 0.0
    while (j < 6.28) {
        flp cosj = cos(j)
        flp sinj = sin(j)
        
        # 4. Phi Loop (i)
        flp i = 0.0
        while (i < 6.28) {
            flp cosi = cos(i)
            flp sini = sin(i)
            
            # Torus cross-section distance
            flp h = cosj + 2.0
            
            # 3D Distance (D) and Projection constants (t)
            flp D = 1.0 / (sini * h * sinA + sinj * cosA + 5.0)
            flp t = sini * h * cosA - sinj * sinA
            
            # Project the 3D surface to the 2D screen coordinates
            int x = (20.0 + 15.0 * D * (cosi * h * cosB - t * sinB)) as int
            int y = (11.0 + 7.5 * D * (cosi * h * sinB + t * cosB)) as int
            
            # Calculate the Luminance (Surface Normals reacting to simulated light)
            int N = (8.0 * ((sinj * sinA - sini * cosj * cosA) * cosB - sini * cosj * sinA - sinj * cosA - cosi * cosj * sinB)) as int
            
            # 5. Draw it if it's on-screen and closer than the previous pixel!
            if (x >= 0 and x < 40 and y >= 0 and y < 22) {
                if (D > z_buffer[y][x]) {
                    
                    z_buffer[y][x] = D
                    
                    if (N > 0) {
                        // Cap at max shade index (12)
                        if (N > 12) { 
                            N = 12 
                        }
                        // Write the integer index to the buffer
                        screen_buffer[y][x] = N
                    } else {
                        // Write 1 (the darkest shade) if it's in shadow
                        screen_buffer[y][x] = 1
                    }
                }
            }
            # Step size (Lower = more precise, Higher = faster AST execution)
            i += 0.08
        }
        j += 0.08
    }
    
    # 6. Push buffer to Terminal
    clear() 
    
    y = 0
    while (y < 22) {
        str row_str = ""
        int x = 0
        
        while (x < 40) {
            // Concatenate the correct character using the integer index
            row_str ~= shades[screen_buffer[y][x]]
            x += 1
        }
        
        print(row_str)
        y += 1
    }
}


# --- MAIN EVENT LOOP ---

flp rotation_A = 0.0
flp rotation_B = 0.0

# Infinite loop!
while (true) {
    render_frame(rotation_A, rotation_B)
    
    # Spin step
    rotation_A += 0.04
    rotation_B += 0.02
}
